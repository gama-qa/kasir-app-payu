---
// src/pages/login.astro
import Footer from '../components/ui/Footer.astro';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Owner - MADEBYPAYU</title>
    <script src="https://cdn.tailwindcss.com" is:inline></script>
  </head>
  <body class="bg-amber-50/40 min-h-screen flex flex-col items-center justify-between p-4">
    
    <!-- TOP SPACER FOR BALANCE -->
    <div class="hidden sm:block"></div>

    <!-- MAIN LOGIN CARD -->
    <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md border border-stone-100 my-auto">
      
      <!-- LOGO & HEADER SECTION -->
      <div class="text-center mb-8">
        <img 
          src="/payu-logo.png" 
          alt="Logo MADEBYPAYU" 
          class="w-40 mx-auto mb-2 object-contain"
        />
        <p class="text-sm text-stone-500 font-medium">Portal Login Owner Dashboard</p>
      </div>

      <form id="loginForm" class="space-y-5">
        <div>
          <label class="block text-xs font-semibold text-stone-600 uppercase tracking-wider mb-2">Username</label>
          <input 
            type="text" 
            id="username" 
            required
            placeholder="Masukkan username Anda"
            class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:outline-none focus:ring-2 focus:ring-stone-800 transition text-sm font-medium"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-stone-600 uppercase tracking-wider mb-2">Password</label>
          <input 
            type="password" 
            id="password" 
            required
            placeholder="••••••••"
            class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:outline-none focus:ring-2 focus:ring-stone-800 transition text-sm font-medium"
          />
        </div>

        <div id="errorMessage" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-600 text-xs font-medium text-center"></div>

        <button 
          type="submit" 
          id="btnSubmit"
          class="w-full py-3.5 px-4 bg-stone-800 hover:bg-stone-900 text-white font-semibold rounded-xl shadow-lg transition duration-200 text-sm active:scale-[0.99]"
        >
          Masuk ke Dashboard
        </button>
      </form>
    </div>

    <!-- FOOTER CREDIT SECTION (komponen bersama, sama dengan dashboard) -->
    <Footer />

    <script>
      // Jalankan cek session jika sudah login
      const userSession = localStorage.getItem('user_session');
      if (userSession) {
        window.location.href = '/dashboard';
      }

      const form = document.getElementById('loginForm') as HTMLFormElement;
      const errorDiv = document.getElementById('errorMessage') as HTMLDivElement;
      const btnSubmit = document.getElementById('btnSubmit') as HTMLButtonElement;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorDiv.classList.add('hidden');
        btnSubmit.innerText = 'Memproses...';
        btnSubmit.disabled = true;

        const username = (document.getElementById('username') as HTMLInputElement).value;
        const password = (document.getElementById('password') as HTMLInputElement).value;

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          });

          const data = await res.json();

          if (data.success) {
            // Simpan data user & brand_id ke LocalStorage
            localStorage.setItem('user_session', JSON.stringify(data.user));
            
            // Redirect ke halaman dashboard
            window.location.href = '/dashboard';
          } else {
            errorDiv.innerText = data.message || 'Login gagal, periksa username/password!';
            errorDiv.classList.remove('hidden');
            btnSubmit.innerText = 'Masuk ke Dashboard';
            btnSubmit.disabled = false;
          }
        } catch (err) {
          errorDiv.innerText = 'Koneksi server terputus!';
          errorDiv.classList.remove('hidden');
          btnSubmit.innerText = 'Masuk ke Dashboard';
          btnSubmit.disabled = false;
        }
      });
    </script>
  </body>
</html>