---
// src/pages/dashboard/index.astro
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PageHeader from '../../components/dashboard/PageHeader.astro';
import StatCard from '../../components/dashboard/StatCard.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Icon from '../../components/ui/Icon.astro';
import Select from '../../components/ui/Select.astro';
import Table from '../../components/ui/Table.astro';

const trxColumns = [
  { key: 'transaction_code', label: 'Kode nota' },
  { key: 'waktu', label: 'Waktu' },
  { key: 'menu_terbeli', label: 'Menu' },
  { key: 'qty', label: 'Qty', numeric: true },
  { key: 'subtotal', label: 'Subtotal', numeric: true },
  { key: 'payment_method', label: 'Metode bayar' },
];

const trendColumns = [
  { key: 'date', label: 'Tanggal' },
  { key: 'omset', label: 'Omzet', numeric: true },
];

const defaultPeriodLabel = '7 hari terakhir';

// Placeholder nilai selama data pertama dimuat (diganti textContent oleh script).
const skeleton = 'inline-block rounded-md bg-muted align-middle';
---

<DashboardLayout title="Ringkasan" active="overview">
  <Fragment slot="head">
    <!-- Dikunci ke versi yang sebelumnya dimuat oleh URL tanpa versi (4.6.1). -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.6.1/dist/chart.umd.min.js"></script>
  </Fragment>

  <div class="space-y-6">
    <PageHeader title="Ringkasan" description="Penjualan merek Anda pada periode yang dipilih.">
      <Select slot="actions" id="selectPeriod" label="Periode" hideLabel icon="calendar" class="w-52">
        <option value="today">Hari ini</option>
        <option value="week" selected>{defaultPeriodLabel}</option>
        <option value="month">30 hari terakhir</option>
      </Select>
    </PageHeader>

    <!-- STATE ERROR (satu untuk seluruh halaman, karena semua data dari satu request) -->
    <div id="dashboardError" hidden>
      <Card>
        <EmptyState
          variant="error"
          title="Ringkasan gagal dimuat"
          description="Periksa koneksi internet, lalu coba lagi."
        >
          <Button variant="outline" size="sm" data-retry>
            <Icon name="refresh-cw" />
            Coba lagi
          </Button>
        </EmptyState>
      </Card>
    </div>

    <!-- KONTEN. Saat ganti periode, tampilan lama diredupkan (tanpa kedip skeleton). -->
    <div
      id="dashboardContent"
      aria-busy="true"
      class="space-y-4 transition-opacity duration-150 data-refreshing:opacity-60"
    >
      <!-- Metrik. Warna ikon mengikuti urutan token data chart-1 → chart-4. -->
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard label="Omzet" icon="wallet" tone="chart-1" valueId="cardOmset" loading>
          <span slot="hint" data-period-label>{defaultPeriodLabel}</span>
        </StatCard>
        <StatCard
          label="Laba kotor (estimasi)"
          icon="trending-up"
          tone="chart-2"
          valueId="cardProfit"
          hint="Harga jual dikurangi HPP"
          loading
        />
        <StatCard label="Porsi terjual" icon="soup" tone="chart-3" valueId="cardPorsi" loading>
          <span slot="hint" data-period-label>{defaultPeriodLabel}</span>
        </StatCard>
        <StatCard label="Transaksi" icon="receipt-text" tone="chart-4" valueId="cardNota" loading>
          <span slot="hint" data-period-label>{defaultPeriodLabel}</span>
        </StatCard>
      </div>

      <div class="grid gap-4 xl:grid-cols-3">
        <!-- Tren omzet + komposisi omzet -->
        <Card title="Tren omzet" description="Omzet per hari pada periode ini" class="xl:col-span-2">
          <div class="grid gap-6 lg:grid-cols-[12rem_minmax(0,1fr)]">
            <dl class="grid content-start gap-5 sm:grid-cols-3 lg:grid-cols-1">
              <div>
                <dt class="text-xs text-muted-foreground">Omzet harian tertinggi</dt>
                <dd id="trendPeak" class="mt-1 text-2xl font-semibold tracking-tight">
                  <span class:list={[skeleton, 'h-7 w-32']}></span>
                </dd>
                <dd id="trendPeakDate" class="mt-1 text-xs text-muted-foreground"></dd>
              </div>
              <div>
                <dt class="text-xs text-muted-foreground">Rata-rata per transaksi</dt>
                <dd id="avgPerTrx" class="mt-1 text-xl font-semibold tracking-tight">
                  <span class:list={[skeleton, 'h-6 w-28']}></span>
                </dd>
              </div>
              <!-- Komposisi omzet: laba kotor vs HPP, dari angka ringkasan yang sama. -->
              <div>
                <dt class="text-xs text-muted-foreground">Margin laba kotor</dt>
                <dd id="compositionMargin" class="mt-1 text-xl font-semibold tracking-tight">
                  <span class:list={[skeleton, 'h-6 w-16']}></span>
                </dd>
                <dd class="mt-2">
                  <div id="compositionBar" role="img" class="flex h-2 gap-0.5 overflow-hidden rounded-full bg-muted">
                    <div id="compositionProfitBar" class="h-full rounded-full bg-chart-2" style="width: 0%"></div>
                    <div id="compositionCostBar" class="h-full rounded-full bg-muted-foreground/40" style="width: 0%"></div>
                  </div>
                  <ul class="mt-2 grid gap-1 text-xs text-muted-foreground">
                    <li class="flex items-center gap-2">
                      <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-chart-2"></span>
                      Laba
                      <span id="compositionProfit" class="ml-auto font-medium text-foreground tabular-nums"></span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-muted-foreground/40"></span>
                      HPP
                      <span id="compositionCost" class="ml-auto font-medium text-foreground tabular-nums"></span>
                    </li>
                  </ul>
                </dd>
              </div>
            </dl>

            <div data-block="trend" class="min-w-0">
              <div data-view="loading" aria-hidden="true" class="h-64 rounded-lg bg-muted"></div>

              <div data-view="ready" hidden>
                <div class="relative h-64">
                  <canvas id="salesChartCanvas" role="img" aria-label="Grafik tren omzet per hari"></canvas>
                </div>
              </div>

              <div data-view="empty" hidden>
                <EmptyState
                  size="sm"
                  icon="chart-line"
                  title="Belum ada penjualan"
                  description="Tidak ada transaksi pada periode ini."
                />
              </div>

              <div data-view="single" hidden>
                <EmptyState
                  size="sm"
                  icon="chart-line"
                  title="Belum cukup data untuk tren"
                  description="Tren tampil bila ada penjualan di minimal 2 hari. Pilih rentang yang lebih panjang."
                />
              </div>
            </div>
          </div>

          <details class="mt-4">
            <summary
              class="cursor-pointer text-xs font-medium text-muted-foreground transition-colors duration-150 hover:text-foreground"
            >
              Lihat omzet per hari dalam tabel
            </summary>
            <div class="-mx-5 mt-3 border-t border-border">
              <Table columns={trendColumns} bodyId="trendTableBody" caption="Omzet per hari" />
            </div>
          </details>
        </Card>

        <!-- Menu terlaris: peringkat 1 disorot, sisanya warna lebih muda. -->
        <Card title="Menu terlaris" description="Berdasarkan porsi terjual">
          <div data-block="topMenu">
            <div data-view="loading" aria-hidden="true" class="space-y-5">
              {
                [80, 64, 48, 36, 24].map((width) => (
                  <div class="flex gap-3">
                    <div class="size-6 shrink-0 rounded-md bg-muted" />
                    <div class="flex-1">
                      <div class="flex justify-between gap-4">
                        <div class="h-4 w-32 rounded-md bg-muted" />
                        <div class="h-4 w-12 rounded-md bg-muted" />
                      </div>
                      <div class="mt-2 h-2 rounded-full bg-muted" style={`width: ${width}%`} />
                    </div>
                  </div>
                ))
              }
            </div>

            <ol id="topMenuList" data-view="ready" class="space-y-5" hidden></ol>

            <div data-view="empty" hidden>
              <EmptyState
                size="sm"
                icon="utensils-crossed"
                title="Belum ada menu terjual"
                description="Tidak ada transaksi pada periode ini."
              />
            </div>
          </div>
        </Card>
      </div>

      <!-- Transaksi terbaru -->
      <Card title="Transaksi terbaru" description="5 item terakhir dari semua periode" padding="none">
        <Button slot="actions" variant="outline" size="sm" href="/dashboard/transactions">
          Lihat semua
          <Icon name="arrow-right" />
        </Button>

        <div data-block="trx">
          <div data-view="loading">
            <Table columns={trxColumns} loading skeletonRows={5} />
          </div>
          <div data-view="ready" hidden>
            <Table columns={trxColumns} bodyId="tableTrxBody" caption="Transaksi terbaru" />
          </div>
          <div data-view="empty" hidden>
            <EmptyState
              size="sm"
              icon="receipt-text"
              title="Belum ada transaksi"
              description="Transaksi dari aplikasi kasir akan muncul di sini."
            />
          </div>
        </div>
      </Card>
    </div>
  </div>

  <!-- Template baris: diisi JS dengan textContent (aman dari HTML di data). -->
  <template id="tplTrxRow">
    <tr>
      <td data-field="transaction_code" class="font-medium whitespace-nowrap"></td>
      <td data-field="waktu" class="whitespace-nowrap text-muted-foreground"></td>
      <td data-field="menu_terbeli"></td>
      <td data-field="qty" data-numeric></td>
      <td data-field="subtotal" data-numeric></td>
      <td>
        <Badge variant="outline" size="sm"><span data-field="payment_method"></span></Badge>
      </td>
    </tr>
  </template>

  <template id="tplTrendRow">
    <tr>
      <td data-field="date"></td>
      <td data-field="omset" data-numeric></td>
    </tr>
  </template>

  <!-- data-top pada <li> menandai peringkat 1 (bar & nomor disorot). -->
  <template id="tplTopMenuItem">
    <li class="group/item flex gap-3">
      <span
        data-field="rank"
        class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted text-xs font-medium text-muted-foreground tabular-nums group-data-[top]/item:bg-chart-3/15 group-data-[top]/item:text-foreground"
      ></span>
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline justify-between gap-4 text-sm">
          <span data-field="name" class="min-w-0 truncate group-data-[top]/item:font-medium"></span>
          <span class="shrink-0 text-muted-foreground tabular-nums"><span data-field="qty"></span> porsi</span>
        </div>
        <div class="mt-2 h-2 rounded-full bg-muted">
          <div data-field="bar" class="h-full rounded-full bg-chart-3/40 group-data-[top]/item:bg-chart-3"></div>
        </div>
      </div>
    </li>
  </template>

  <script>
    declare const Chart: any;

    let salesChartInstance: any = null;

    // 1. Cek Auth Session — TIDAK BERUBAH
    const sessionData = localStorage.getItem('user_session');
    if (!sessionData) {
      window.location.href = '/login';
    }

    const user = JSON.parse(sessionData || '{}');

    // Format — formatRupiah TIDAK BERUBAH
    const formatRupiah = (number: number) => {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
    };
    const formatAngka = (value: number) => new Intl.NumberFormat('id-ID').format(value);
    const formatPersen = (ratio: number) =>
      new Intl.NumberFormat('id-ID', { style: 'percent', maximumFractionDigits: 1 }).format(ratio);
    const formatTanggal = (dateKey: string) =>
      new Date(`${dateKey}T00:00:00`).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
    const formatHari = (dateKey: string) =>
      new Date(`${dateKey}T00:00:00`).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'short' });

    // ------------------------------------------------------------------
    // Helper tampilan: state blok, template, token warna
    // ------------------------------------------------------------------
    const content = document.getElementById('dashboardContent') as HTMLElement;
    const errorView = document.getElementById('dashboardError') as HTMLElement;
    const selectPeriod = document.getElementById('selectPeriod') as HTMLSelectElement;
    let hasLoaded = false;

    /** Tampilkan satu "view" (loading / ready / empty / …) di dalam blok data. */
    const setBlockState = (block: string, state: string) => {
      document.querySelectorAll<HTMLElement>(`[data-block="${block}"] > [data-view]`).forEach((view) => {
        view.hidden = view.dataset.view !== state;
      });
    };

    const cloneTemplate = (id: string) =>
      (document.getElementById(id) as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;

    const setField = (root: ParentNode, field: string, value: string) => {
      const el = root.querySelector(`[data-field="${field}"]`);
      if (el) el.textContent = value;
    };

    const setText = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };

    const setStat = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = value;
      el.removeAttribute('aria-busy');
    };

    const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    /** #rrggbb → rgba() untuk kanvas (Chart.js tidak membaca CSS variable). */
    const withAlpha = (hex: string, alpha: number) => {
      const n = parseInt(hex.replace('#', ''), 16);
      return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
    };

    const showError = (show: boolean) => {
      errorView.hidden = !show;
      content.hidden = show;
    };

    const updatePeriodLabels = (period: string) => {
      const label = selectPeriod?.querySelector(`option[value="${period}"]`)?.textContent ?? '';
      document.querySelectorAll('[data-period-label]').forEach((el) => {
        el.textContent = label;
      });
    };

    // Garis vertikal putus-putus di posisi X yang sedang di-hover.
    const crosshairPlugin = {
      id: 'crosshair',
      beforeDatasetsDraw(chart: any) {
        const active = chart.tooltip?.getActiveElements?.() ?? [];
        if (!active.length) return;
        const { ctx, chartArea } = chart;
        const x = active[0].element.x;
        ctx.save();
        ctx.strokeStyle = withAlpha(token('--muted-foreground'), 0.5);
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(x, chartArea.top);
        ctx.lineTo(x, chartArea.bottom);
        ctx.stroke();
        ctx.restore();
      },
    };

    /** Isian area: warna seri memudar ke transparan di dasar grafik. */
    const areaFill = (series: string) => (context: any) => {
      const { ctx, chartArea } = context.chart;
      if (!chartArea) return withAlpha(series, 0.1);
      const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
      gradient.addColorStop(0, withAlpha(series, 0.22));
      gradient.addColorStop(1, withAlpha(series, 0));
      return gradient;
    };

    // ------------------------------------------------------------------
    // Angka turunan untuk tampilan (dihitung dari data respons yang sama;
    // tidak ada request atau perhitungan bisnis baru di server).
    // ------------------------------------------------------------------
    const renderPeakDay = (chartData: any[]) => {
      if (chartData.length === 0) {
        setText('trendPeak', '–');
        setText('trendPeakDate', 'Belum ada penjualan');
        return;
      }
      const peak = chartData.reduce((best, d) => (Number(d.omset) > Number(best.omset) ? d : best));
      setText('trendPeak', formatRupiah(Number(peak.omset)));
      setText('trendPeakDate', peak.date_key ? formatHari(peak.date_key) : peak.day_name);
    };

    const renderSummaryDetails = (summary: any) => {
      const omset = Number(summary.total_omset);
      const profit = Number(summary.total_profit);
      const nota = Number(summary.total_nota);

      setText('avgPerTrx', nota > 0 ? formatRupiah(omset / nota) : '–');
      setText('compositionProfit', formatRupiah(profit));
      setText('compositionCost', formatRupiah(omset - profit));

      const profitShare = omset > 0 ? Math.min(Math.max(profit / omset, 0), 1) : 0;
      const costShare = omset > 0 ? 1 - profitShare : 0;
      const profitBar = document.getElementById('compositionProfitBar') as HTMLElement;
      const costBar = document.getElementById('compositionCostBar') as HTMLElement;
      profitBar.style.width = `${profitShare * 100}%`;
      costBar.style.width = `${costShare * 100}%`;
      profitBar.hidden = profitShare === 0;
      costBar.hidden = costShare === 0;

      setText('compositionMargin', omset > 0 ? formatPersen(profit / omset) : '–');
      document
        .getElementById('compositionBar')
        ?.setAttribute(
          'aria-label',
          omset > 0
            ? `Laba kotor ${formatPersen(profitShare)} dan HPP ${formatPersen(costShare)} dari omzet`
            : 'Belum ada omzet pada periode ini',
        );
    };

    // 2. Render Line Chart (Tren Omzet)
    //    Data yang dipakai TIDAK BERUBAH (date_key/day_name & omset); hanya gaya & state.
    const renderSalesChart = (chartData: any[]) => {
      if (salesChartInstance) salesChartInstance.destroy();
      salesChartInstance = null;

      const labels = chartData.map((d) => (d.date_key ? formatTanggal(d.date_key) : d.day_name));
      const dataValues = chartData.map((d) => Number(d.omset));

      // Tabel pendamping grafik (aksesibilitas)
      const trendBody = document.getElementById('trendTableBody') as HTMLElement;
      trendBody.replaceChildren(
        ...chartData.map((_, i) => {
          const row = cloneTemplate('tplTrendRow');
          setField(row, 'date', labels[i]);
          setField(row, 'omset', formatRupiah(dataValues[i]));
          return row;
        }),
      );

      renderPeakDay(chartData);

      if (chartData.length === 0) return setBlockState('trend', 'empty');
      if (chartData.length < 2) return setBlockState('trend', 'single');
      setBlockState('trend', 'ready');

      const series = token('--chart-1');
      const surface = token('--background');
      const muted = token('--muted-foreground');
      const grid = token('--border');
      const fontFamily = getComputedStyle(document.body).fontFamily;

      const canvas = document.getElementById('salesChartCanvas') as HTMLCanvasElement;
      salesChartInstance = new Chart(canvas, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Omzet',
              data: dataValues,
              borderColor: series,
              backgroundColor: areaFill(series),
              borderWidth: 2,
              borderJoinStyle: 'round',
              borderCapStyle: 'round',
              fill: true,
              cubicInterpolationMode: 'monotone',
              pointRadius: dataValues.length <= 14 ? 4 : 0,
              pointHoverRadius: 5,
              pointHitRadius: 12,
              pointBackgroundColor: series,
              pointBorderColor: surface,
              pointBorderWidth: 2,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          font: { family: fontFamily },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: surface,
              borderColor: grid,
              borderWidth: 1,
              padding: 10,
              cornerRadius: 8,
              displayColors: false,
              titleColor: muted,
              titleFont: { family: fontFamily, size: 12, weight: '400' },
              bodyColor: token('--foreground'),
              bodyFont: { family: fontFamily, size: 13, weight: '600' },
              callbacks: { label: (ctx: any) => formatRupiah(ctx.parsed.y) },
            },
          },
          scales: {
            y: {
              beginAtZero: true,
              border: { display: false, dash: [4, 4] },
              grid: { color: grid, lineWidth: 1, drawTicks: false },
              ticks: {
                color: muted,
                padding: 8,
                maxTicksLimit: 5,
                font: { family: fontFamily, size: 12 },
                callback: (value: number) => formatRupiah(Number(value)),
              },
            },
            x: {
              border: { display: false },
              grid: { display: false },
              ticks: { color: muted, maxRotation: 0, autoSkip: true, font: { family: fontFamily, size: 12 } },
            },
          },
        },
        plugins: [crosshairPlugin],
      });
    };

    // 3. Menu Terlaris — data sama (product_name, total_qty), ditampilkan
    //    sebagai bar horizontal berurutan; peringkat 1 disorot.
    const renderTopMenu = (menuData: any[]) => {
      const list = document.getElementById('topMenuList') as HTMLElement;
      if (menuData.length === 0) {
        list.replaceChildren();
        return setBlockState('topMenu', 'empty');
      }

      const max = Math.max(...menuData.map((m) => Number(m.total_qty)), 1);
      list.replaceChildren(
        ...menuData.map((m, index) => {
          const qty = Number(m.total_qty);
          const item = cloneTemplate('tplTopMenuItem');
          if (index === 0) item.querySelector('li')?.setAttribute('data-top', '');
          setField(item, 'rank', String(index + 1));
          setField(item, 'name', m.product_name);
          setField(item, 'qty', formatAngka(qty));
          const bar = item.querySelector<HTMLElement>('[data-field="bar"]');
          if (bar) bar.style.width = `${(qty / max) * 100}%`;
          return item;
        }),
      );
      setBlockState('topMenu', 'ready');
    };

    // Tabel transaksi terbaru — field yang ditampilkan TIDAK BERUBAH.
    const renderRecentTransactions = (rows: any[]) => {
      const tbody = document.getElementById('tableTrxBody') as HTMLElement;
      if (rows.length === 0) {
        tbody.replaceChildren();
        return setBlockState('trx', 'empty');
      }

      tbody.replaceChildren(
        ...rows.map((trx) => {
          const row = cloneTemplate('tplTrxRow');
          setField(row, 'transaction_code', trx.transaction_code);
          setField(row, 'waktu', trx.waktu);
          setField(row, 'menu_terbeli', trx.menu_terbeli);
          setField(row, 'qty', formatAngka(Number(trx.qty)));
          setField(row, 'subtotal', formatRupiah(Number(trx.subtotal)));
          setField(row, 'payment_method', trx.payment_method);
          return row;
        }),
      );
      setBlockState('trx', 'ready');
    };

    // 4. Fetch Live Data dari API — request TIDAK BERUBAH.
    const loadDashboardData = async (period = 'week') => {
      content.setAttribute('aria-busy', 'true');
      if (hasLoaded) content.dataset.refreshing = '';

      try {
        const brandId = user.brand_id || 1;
        const res = await fetch(`/api/dashboard/stats?brand_id=${brandId}&period=${period}`);
        const result = await res.json();

        if (result.success) {
          // Update 4 metrik
          setStat('cardOmset', formatRupiah(result.summary.total_omset));
          setStat('cardProfit', formatRupiah(result.summary.total_profit));
          setStat('cardPorsi', formatAngka(result.summary.total_porsi_terjual));
          setStat('cardNota', formatAngka(result.summary.total_nota));
          updatePeriodLabels(period);
          renderSummaryDetails(result.summary);

          // Render grafik & tabel
          renderSalesChart(result.sales_chart || []);
          renderTopMenu(result.top_menu || []);
          renderRecentTransactions(result.recent_transactions || []);

          hasLoaded = true;
          showError(false);
        } else {
          showError(true);
        }
      } catch (err) {
        console.error('Error fetching stats:', err);
        showError(true);
      } finally {
        content.removeAttribute('aria-busy');
        delete content.dataset.refreshing;
      }
    };

    loadDashboardData('week');

    // Ganti periode — TIDAK BERUBAH
    document.getElementById('selectPeriod')?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      loadDashboardData(val);
    });

    // Coba lagi setelah error
    document.querySelector('[data-retry]')?.addEventListener('click', () => {
      showError(false);
      loadDashboardData(selectPeriod.value);
    });
  </script>
</DashboardLayout>
