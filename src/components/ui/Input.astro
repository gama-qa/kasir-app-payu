---
/*
 * Input teks/angka dengan label, hint, dan pesan error.
 * Atribut HTML lain (type, name, placeholder, required, inputmode, value, …)
 * diteruskan ke <input>. Prop `class` diterapkan ke pembungkus.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Size = 'sm' | 'md';

interface Props extends Omit<HTMLAttributes<'input'>, 'size' | 'prefix'> {
  id: string;
  label?: string;
  /** Sembunyikan label secara visual (tetap dibaca screen reader). */
  hideLabel?: boolean;
  hint?: string;
  /** Bila diisi, input ditandai invalid dan pesan ini menggantikan hint. */
  error?: string;
  /** Ikon di kiri, mis. "search". */
  icon?: IconName;
  /** Teks di kiri, mis. "Rp". Diabaikan bila `icon` diisi. */
  prefix?: string;
  size?: Size;
}

const {
  id,
  label,
  hideLabel = false,
  hint,
  error,
  icon,
  prefix,
  size = 'md',
  class: className,
  ...rest
} = Astro.props;

const message = error ?? hint;
const messageId = message ? `${id}-hint` : undefined;
const hasLeading = Boolean(icon || prefix);

const sizes: Record<Size, string> = {
  sm: 'h-8',
  md: 'h-9',
};
---

<!-- content-start: jangan ikut meregang bila field sebaris lebih tinggi (ikon/prefix jadi meleset). -->
<div class:list={['grid content-start gap-2', className]}>
  {
    label && (
      <label for={id} class:list={['text-xs font-medium', hideLabel && 'sr-only']}>
        {label}
      </label>
    )
  }

  <div class="relative">
    {
      icon && (
        <Icon
          name={icon}
          class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-muted-foreground"
        />
      )
    }
    {
      !icon && prefix && (
        <span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-sm text-muted-foreground">
          {prefix}
        </span>
      )
    }
    <input
      id={id}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={messageId}
      class:list={[
        'w-full rounded-md border border-input bg-background px-3 text-sm transition-colors duration-150',
        'placeholder:text-muted-foreground',
        'focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/20 focus-visible:outline-none',
        'aria-invalid:border-destructive aria-invalid:focus-visible:ring-destructive/20',
        'disabled:cursor-not-allowed disabled:opacity-50',
        sizes[size],
        hasLeading && 'pl-9',
      ]}
      {...rest}
    />
  </div>

  {
    message && (
      <p id={messageId} class:list={['text-xs', error ? 'text-destructive' : 'text-muted-foreground']}>
        {message}
      </p>
    )
  }
</div>
