---
/*
 * <select> native bergaya sama dengan Input. Opsi diisi lewat slot default.
 * Atribut HTML lain (name, required, …) diteruskan ke <select>.
 * Prop `class` diterapkan ke pembungkus.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Size = 'sm' | 'md';

interface Props extends Omit<HTMLAttributes<'select'>, 'size'> {
  id: string;
  label?: string;
  /** Sembunyikan label secara visual (tetap dibaca screen reader). */
  hideLabel?: boolean;
  hint?: string;
  error?: string;
  /** Ikon di kiri, mis. "calendar". */
  icon?: IconName;
  size?: Size;
}

const {
  id,
  label,
  hideLabel = false,
  hint,
  error,
  icon,
  size = 'md',
  class: className,
  ...rest
} = Astro.props;

const message = error ?? hint;
const messageId = message ? `${id}-hint` : undefined;

const sizes: Record<Size, string> = {
  sm: 'h-8',
  md: 'h-9',
};
---

<div class:list={['grid content-start gap-2', className]}>
  {
    label && (
      <label for={id} class:list={['text-xs font-medium', hideLabel && 'sr-only']}>
        {label}
      </label>
    )
  }

  <div class="relative">
    {
      icon && (
        <Icon
          name={icon}
          class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-muted-foreground"
        />
      )
    }
    <select
      id={id}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={messageId}
      class:list={[
        'w-full appearance-none rounded-md border border-input bg-background pr-9 pl-3 text-sm transition-colors duration-150',
        'focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/20 focus-visible:outline-none',
        'aria-invalid:border-destructive aria-invalid:focus-visible:ring-destructive/20',
        'disabled:cursor-not-allowed disabled:opacity-50',
        sizes[size],
        icon && 'pl-9',
      ]}
      {...rest}
    >
      <slot />
    </select>
    <Icon
      name="chevron-down"
      class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-muted-foreground"
    />
  </div>

  {
    message && (
      <p id={messageId} class:list={['text-xs', error ? 'text-destructive' : 'text-muted-foreground']}>
        {message}
      </p>
    )
  }
</div>
