---
// src/components/Sidebar.astro
interface Props {
  activeMenu: 'overview' | 'products' | 'transactions';
}

const { activeMenu } = Astro.props;
---

<aside class="w-60 bg-white border-r border-stone-200/60 min-h-screen flex flex-col justify-between p-4 shrink-0">
  <div>
    <!-- Logo & Title Header -->
    <div class="mb-6 px-1">
      <img 
        src="/payu-logo-2.png" 
        alt="Logo MADEBYPAYU" 
        class="h-8 w-auto object-contain mb-1"
      />
      <span class="text-[11px] text-stone-400 font-medium block">Menu Pemilik Bisnis</span>
    </div>

    <!-- Navigation Menu -->
    <nav class="space-y-2">
      <!-- Ringkasan Utama / Overview -->
      <a 
        href="/dashboard" 
        class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all duration-200 ${
          activeMenu === 'overview' 
            ? 'bg-[#3D2924] text-white shadow-md shadow-[#3D2924]/20' 
            : 'text-stone-700 hover:bg-stone-100/80'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
          <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
        </svg>
        <span>Ringkasan Utama</span>
      </a>

      <!-- Produk & Stok -->
      <a 
        href="/dashboard/products" 
        class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all duration-200 ${
          activeMenu === 'products' 
            ? 'bg-[#3D2924] text-white shadow-md shadow-[#3D2924]/20' 
            : 'text-stone-700 hover:bg-stone-100/80'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
          <path d="M7 2v20"></path>
          <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path>
        </svg>
        <span>Produk & Stok</span>
      </a>

      <!-- Riwayat Transaksi -->
      <a 
        href="/dashboard/transactions" 
        class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all duration-200 ${
          activeMenu === 'transactions' 
            ? 'bg-[#3D2924] text-white shadow-md shadow-[#3D2924]/20' 
            : 'text-stone-700 hover:bg-stone-100/80'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2"></rect>
          <line x1="7" y1="8" x2="17" y2="8"></line>
          <line x1="7" y1="12" x2="17" y2="12"></line>
          <line x1="7" y1="16" x2="13" y2="16"></line>
        </svg>
        <span>Riwayat Transaksi</span>
      </a>

      <!-- Buka Aplikasi Kasir -->
      <div class="pt-1.5">
        <a 
          href="/cashier" 
          target="_blank"
          class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-bold text-xs text-stone-800 border-2 border-dashed border-stone-300 hover:border-[#3D2924] hover:bg-stone-50 transition-all duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span>Buka Aplikasi Kasir</span>
        </a>
      </div>
    </nav>
  </div>

  <!-- Profile Card & Logout Button Below -->
  <div class="border-t border-stone-100 pt-4 space-y-2.5">
    <!-- Profile Info Box -->
    <div class="bg-[#FBF8F3] p-2.5 rounded-xl flex items-center gap-2.5 border border-stone-200/50">
      <div id="sidebarAvatar" class="w-9 h-9 bg-[#3D2924] text-white rounded-xl flex items-center justify-center font-bold text-xs shadow-sm shrink-0">
        EM
      </div>
      <div class="overflow-hidden">
        <p id="sidebarOwnerName" class="font-bold text-xs text-[#3D2924] leading-tight truncate">Loading...</p>
        <p id="sidebarBrandBadge" class="text-[10px] text-stone-400 font-medium mt-0.5">ID Merek: #-</p>
      </div>
    </div>

    <!-- Button Trigger Logout -->
    <button 
      id="sidebarBtnLogout" 
      class="w-full py-2.5 px-3 rounded-xl border border-rose-200 bg-rose-50/60 hover:bg-rose-100/80 text-rose-700 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-[0.98]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      <span>Keluar dari Akun</span>
    </button>
  </div>
</aside>

<!-- CUSTOM MODAL KONFIRMASI LOGOUT -->
<div 
  id="logoutModal" 
  class="fixed inset-0 bg-stone-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-200"
>
  <div class="bg-white rounded-3xl p-6 max-w-sm w-full shadow-2xl border border-stone-100 text-center transform scale-95 transition-all duration-200" id="logoutModalCard">
    <div class="w-14 h-14 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl">
      🚪
    </div>
    <h3 class="font-bold text-stone-800 text-lg mb-1">Konfirmasi Keluar</h3>
    <p class="text-xs text-stone-500 mb-6 leading-relaxed">Apakah Anda yakin ingin keluar dari akun ini? Anda harus login kembali untuk mengakses dashboard.</p>
    
    <div class="grid grid-cols-2 gap-3">
      <button 
        id="btnCancelLogout" 
        class="py-3 px-4 rounded-xl border border-stone-200 text-stone-600 font-bold text-xs hover:bg-stone-50 transition active:scale-[0.98]"
      >
        Batal
      </button>
      <button 
        id="btnConfirmLogout" 
        class="py-3 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md shadow-rose-600/20 transition active:scale-[0.98]"
      >
        Ya, Keluar
      </button>
    </div>
  </div>
</div>

<script>
  // Load Dynamic Profile User dari LocalStorage
  const sessionData = localStorage.getItem('user_session');
  if (sessionData) {
    const user = JSON.parse(sessionData);
    
    const nameEl = document.getElementById('sidebarOwnerName');
    const badgeEl = document.getElementById('sidebarBrandBadge');
    const avatarEl = document.getElementById('sidebarAvatar');

    if (nameEl) nameEl.innerText = user.name || 'Pemilik Bisnis';
    if (badgeEl) badgeEl.innerText = `ID Merek: #${user.brand_id || 'All'}`;
    
    if (avatarEl && user.name) {
      const initials = user.name.split(' ').map((n: string) => n[0]).join('').substring(0, 2).toUpperCase();
      avatarEl.innerText = initials || 'EM';
    }
  }

  // LOGIK LOGOUT CUSTOM MODAL
  const logoutModal = document.getElementById('logoutModal');
  const logoutModalCard = document.getElementById('logoutModalCard');
  const btnLogoutTrigger = document.getElementById('sidebarBtnLogout');
  const btnCancelLogout = document.getElementById('btnCancelLogout');
  const btnConfirmLogout = document.getElementById('btnConfirmLogout');

  const openModal = () => {
    logoutModal?.classList.remove('opacity-0', 'pointer-events-none');
    logoutModalCard?.classList.remove('scale-95');
    logoutModalCard?.classList.add('scale-100');
  };

  const closeModal = () => {
    logoutModal?.classList.add('opacity-0', 'pointer-events-none');
    logoutModalCard?.classList.remove('scale-100');
    logoutModalCard?.classList.add('scale-95');
  };

  btnLogoutTrigger?.addEventListener('click', openModal);
  btnCancelLogout?.addEventListener('click', closeModal);

  // Tutup modal jika klik di luar area card (backdrop)
  logoutModal?.addEventListener('click', (e) => {
    if (e.target === logoutModal) closeModal();
  });

  // Eksekusi Logout
  btnConfirmLogout?.addEventListener('click', () => {
    localStorage.removeItem('user_session');
    window.location.href = '/';
  });
</script>