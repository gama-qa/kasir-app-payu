---
/*
 * Tombol kurang / jumlah / tambah untuk kartu menu dan daftar pesanan kasir.
 * Script halaman menangani klik lewat data-action="decrease|increase" dan
 * mengisi jumlah ke [data-field="qty"].
 */
import Icon from '../ui/Icon.astro';

interface Props {
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;

const buttonBase =
  'flex shrink-0 items-center justify-center rounded-full transition-colors duration-150 disabled:opacity-40';
const buttonSize = size === 'sm' ? 'size-8' : 'size-9';
---

<div data-part="stepper" class:list={['flex items-center gap-1', className]}>
  <button
    type="button"
    data-action="decrease"
    aria-label="Kurangi"
    class:list={[buttonBase, buttonSize, 'border border-border bg-background hover:bg-muted']}
  >
    <Icon name="minus" size={14} />
  </button>
  <span data-field="qty" class="min-w-6 text-center text-sm font-semibold tabular-nums"></span>
  <button
    type="button"
    data-action="increase"
    aria-label="Tambah"
    class:list={[buttonBase, buttonSize, 'bg-primary text-primary-foreground hover:bg-primary/90']}
  >
    <Icon name="plus" size={14} />
  </button>
</div>
