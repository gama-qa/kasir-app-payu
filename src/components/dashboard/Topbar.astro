---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header
  class="sticky top-0 z-20 flex h-14 shrink-0 items-center gap-2 border-b border-border bg-background px-4 sm:px-6 lg:px-8"
>
  <Button
    variant="ghost"
    size="icon"
    class="-ml-2 lg:hidden"
    data-sidebar-toggle
    aria-controls="dashboard-sidebar"
    aria-expanded="false"
    aria-label="Buka menu navigasi"
  >
    <Icon name="menu" />
  </Button>

  <nav aria-label="Breadcrumb" class="min-w-0 flex-1">
    <ol class="flex items-center gap-2 text-sm">
      <li class="hidden text-muted-foreground sm:block">Dashboard</li>
      <li aria-hidden="true" class="hidden text-muted-foreground sm:block">/</li>
      <li class="truncate font-medium"><span aria-current="page">{title}</span></li>
    </ol>
  </nav>

  <div class="flex min-w-0 items-center gap-3">
    <div class="flex min-w-0 items-center gap-2 text-sm text-muted-foreground">
      <Icon name="store" />
      <span class="sr-only">Merek:</span>
      <span data-session-field="brand" class="max-w-40 truncate">Semua Brand</span>
    </div>
    <!-- Paket akun (Gratis/Premium), diisi script DashboardLayout dari sesi login. -->
    <Badge
      variant="outline"
      data-plan-badge
      data-plan="free"
      class="shrink-0 data-[plan=premium]:border-primary data-[plan=premium]:text-primary"
    >
      <Icon name="crown" size={12} />
      <span data-session-field="plan">Paket Gratis</span>
    </Badge>
  </div>
</header>
