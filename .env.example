# =====================================================================
# Contoh konfigurasi environment kasir-app.
# Salin menjadi .env (di laptop & di server), lalu isi nilainya:
#   cp .env.example .env
# .env TIDAK ikut ke git. Jangan pernah menulis kredensial di kode.
#
# Cara aplikasi membaca nilai ini:
#   - `npm run dev`   → dibaca otomatis dari .env
#   - `npm run build` → nilai .env di mesin build ikut ke dist/ (dist tidak di-commit)
#   - `npm start`     → .env dimuat saat server berjalan; variabel environment
#                       aaPanel (bila di-set) selalu didahulukan
# =====================================================================

# Database PostgreSQL (wajib)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# Folder foto produk yang diunggah (opsional, default ./uploads)
# UPLOAD_DIR=./uploads
